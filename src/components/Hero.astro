---
import { Image } from 'astro:assets';
import headshot from '../assets/Headshot.jpeg';
import TextUsLink from './TextUsLink.astro';
import LangBadge from './LangBadge.astro';
import { PHONE_HREF as phone, PHONE_DISPLAY as phoneDisplay } from '../lib/contact';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro.url);

const badgeIcons = [
  "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
  "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
];
---

<header class="relative bg-gradient-to-b from-primary/[0.03] via-white to-white overflow-hidden">
  <!-- Subtle background decoration for mobile -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-accent/5 rounded-full -translate-y-1/3 translate-x-1/3 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-primary/5 rounded-full translate-y-1/3 -translate-x-1/3 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-4 py-8 md:py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 items-center">
      <!-- Text content — left 60% -->
      <div class="lg:col-span-3">
        <p class="text-sm md:text-base font-semibold uppercase tracking-wider text-accent mb-2">
          {t.hero.eyebrow}
        </p>

        <!-- H1 — names the work -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-text leading-tight mb-3">
          {t.hero.h1}
        </h1>

        <!-- Subhead — the services, then where -->
        <p class="text-lg md:text-xl text-text-secondary font-medium mb-4">
          {t.hero.tagline}
        </p>

        <div class="mb-6">
          <LangBadge variant="hero" />
        </div>

        <!-- Inline trust badges — stacked on mobile, inline on sm+ -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2.5 sm:gap-4 mb-8">
          {t.hero.badges.map((label, i) => (
            <div class="flex items-center gap-1.5 text-sm font-medium text-text-secondary">
              <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={badgeIcons[i]}/>
              </svg>
              {label}
            </div>
          ))}
        </div>

        <!-- Dual CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={phone}
            class="inline-flex items-center justify-center gap-3 bg-accent hover:bg-accent-light text-white font-bold text-lg px-8 py-4 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            {t.hero.callNow}: {phoneDisplay}
          </a>
          <a
            href="#quick-quote"
            class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-light text-white font-bold text-lg px-8 py-4 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg"
          >
            {t.hero.quote}
          </a>
        </div>
        <p class="mt-4">
          <TextUsLink />
        </p>
      </div>

      <!-- Headshot — right 40% -->
      <div class="hidden lg:flex lg:col-span-2 flex-col items-center gap-4">
        <div class="relative w-full max-w-xs rounded-2xl overflow-hidden shadow-lg border border-primary/10">
          <Image src={headshot} alt={t.hero.ownerAlt} width={384} height={477} class="w-full h-auto object-cover" format="webp" quality={80} />
        </div>
        <div class="text-center">
          <p class="text-lg font-bold text-text">{t.hero.ownerName}</p>
          <p class="text-sm text-text-secondary font-medium">{t.hero.ownerTitle}</p>
          <p class="text-xs text-text-secondary/70">{t.hero.license}</p>
        </div>
      </div>
    </div>
  </div>
</header>
