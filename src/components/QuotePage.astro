---
// Dedicated quote page (/quote/, /es/quote/): the target for the Google
// Business Profile booking button and paid ads (?utm_campaign=gbp, =ads).
// Visitors here have already decided, so the page doesn't re-pitch: form at
// the top, Leo's face and license, and Call/Text as the escape hatch.
//
// Short form plus the optional photo (the photo is what lets Leo quote without
// a visit). No language field: the page's language is sent as a hidden field.
// Posts to the same Netlify form ("contact") as the in-page forms, with empty
// copies of the long form's other optional fields so every same-named form
// declares the same field set. Noindexed: it's a conversion page, not content.
import { Image } from "astro:assets";
import headshot from "../assets/Headshot.jpeg";
import Layout from "../layouts/Layout.astro";
import StickyNav from "./StickyNav.astro";
import Footer from "./Footer.astro";
import FormRating from "./FormRating.astro";
import { PHONE_HREF, smsHref } from "../lib/contact";
import { useI18n } from "../i18n";

const id = "quote";
const { locale, t, l } = useI18n(Astro.url);
const field = "w-full px-4 py-3 border border-border rounded-lg bg-background text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors";
---

<Layout title={t.quote.title} description={t.quote.description} noindex={true} hideCtaBar={true}>
  <StickyNav />
  <main class="bg-white py-6 md:py-12">
    <div class="max-w-lg mx-auto px-4">
      <h1 class="text-2xl md:text-3xl font-bold text-text">{t.quote.heading}</h1>
      <p class="text-text-secondary text-sm mt-1 mb-4">{t.contact.responseTime}</p>

      <!-- Owner strip: who's going to call them back -->
      <div class="flex items-center gap-3 mb-4">
        <Image src={headshot} alt={t.contact.ownerAlt} width={56} height={56} class="w-14 h-14 rounded-full object-cover object-[center_20%] shadow-sm ring-2 ring-primary/15" format="webp" quality={80} loading="eager" />
        <div class="leading-tight">
          <p class="font-bold text-text">{t.contact.ownerName}</p>
          <p class="text-sm text-text-secondary">{t.contact.ownerTitle}</p>
          <p class="text-xs text-text-secondary/70">{t.contact.license}</p>
        </div>
      </div>

      <div class="bg-surface border border-border rounded-xl shadow-lg p-5 md:p-7">
        <form
          id={`${id}-form`}
          name="contact"
          method="POST"
          action={l(t.quote.thankYouPath)}
          enctype="multipart/form-data"
          netlify
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <!-- Path plus query string (filled in below), so the submission shows the utm_campaign -->
          <input type="hidden" name="page" value={Astro.url.pathname} />
          <input type="hidden" name="language" value={locale} />
          <input type="hidden" name="email" value="" />
          <input type="hidden" name="message" value="" />
          <p class="hidden" hidden aria-hidden="true">
            <label>{t.contact.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="space-y-4">
            <div>
              <label for={`${id}-name`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.name} <span class="text-red-600">*</span>
              </label>
              <input type="text" id={`${id}-name`} name="name" required autocomplete="name" placeholder={t.contact.namePlaceholder} class={field} />
            </div>

            <div>
              <label for={`${id}-phone`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.phone} <span class="text-red-600">*</span>
              </label>
              <input type="tel" id={`${id}-phone`} name="phone" required inputmode="tel" autocomplete="tel" placeholder={t.contact.phonePlaceholder} class={field} />
            </div>

            <div>
              <label for={`${id}-service`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.service} <span class="text-red-600">*</span>
              </label>
              <select id={`${id}-service`} name="service" required class={`${field} cursor-pointer`}>
                <option value="" disabled selected>{t.contact.selectService}</option>
                {t.contact.services.map((svc) => <option value={svc.value}>{svc.label}</option>)}
              </select>
            </div>

            <!-- Netlify Forms caps a submission at 8 MB. -->
            <div>
              <label for={`${id}-photo`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.photo} <span class="text-text-muted text-xs font-normal">{t.contact.optional}</span>
              </label>
              <input
                type="file"
                id={`${id}-photo`}
                name="photo"
                accept="image/*"
                aria-describedby={`${id}-photo-hint`}
                class="w-full text-sm text-text-secondary file:mr-3 file:px-4 file:py-2.5 file:rounded-lg file:border file:border-border file:bg-background file:text-text file:font-semibold hover:file:border-primary/40 file:cursor-pointer cursor-pointer"
              />
              <p id={`${id}-photo-hint`} class="text-text-muted text-xs mt-1.5">{t.contact.photoHint}</p>
            </div>

            <FormRating />

            <button
              type="submit"
              id={`${id}-submit`}
              class="w-full bg-accent hover:bg-accent-light text-white font-bold text-lg py-4 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg cursor-pointer"
            >
              {t.contact.submit}
            </button>
          </div>
        </form>
      </div>

      <!-- Escape hatch for people who'd rather not fill in a form -->
      <p class="text-text-secondary text-sm text-center mt-6 mb-3">{t.quote.orTalk}</p>
      <div class="grid grid-cols-2 gap-3">
        <a
          href={PHONE_HREF}
          class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-white font-bold px-4 py-3 rounded-lg shadow-sm transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          {t.quote.call}
          <span class="sr-only">{t.bar.callSr}</span>
        </a>
        <a
          href={smsHref(t.sms.body)}
          class="inline-flex items-center justify-center gap-2 bg-surface border border-border hover:border-primary/40 text-text font-bold px-4 py-3 rounded-lg shadow-sm transition-colors"
        >
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
          </svg>
          {t.quote.text}
        </a>
      </div>
    </div>
  </main>
  <Footer quoteHref={`#${id}-form`} />
</Layout>

<script>
  // Static build can't see the query string; add it so Leo's submission shows
  // which link (GBP, Ads) the lead came from.
  const page = document.querySelector<HTMLInputElement>('#quote-form input[name="page"]');
  if (page) page.value = location.pathname + location.search;
</script>
