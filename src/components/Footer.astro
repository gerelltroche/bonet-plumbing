---
import { Image } from 'astro:assets';
import logo from '../assets/logo_with_text.jpeg';

const year = new Date().getFullYear();
const phone = "tel:+14077343968";
const phoneDisplay = "407-734-3968";
---

<footer class="bg-primary-dark border-t border-white/10">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start">
        <a href="/">
          <Image src={logo} alt="Bonet Plumbing LLC" width={64} height={64} class="h-16 w-auto rounded bg-white p-1 mb-2" format="webp" quality={80} loading="lazy" />
        </a>
        <span class="text-lg font-bold text-white/90">Bonet Plumbing LLC</span>
        <a href={phone} class="text-white/70 hover:text-white text-sm transition-colors mt-1">
          {phoneDisplay}
        </a>
        <span class="text-white/50 text-sm">Available 24/7</span>
      </div>

      <!-- Services -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">Services</h3>
        <ul class="space-y-2">
          <li><a href="/repiping" class="text-white/60 hover:text-white text-sm transition-colors">Whole-Home Repiping</a></li>
          <li><a href="/water-heater-services" class="text-white/60 hover:text-white text-sm transition-colors">Water Heaters & Tankless</a></li>
          <li><a href="/repiping#slab-leak" class="text-white/60 hover:text-white text-sm transition-colors">Slab Leak Repair</a></li>
          <li><a href="/repiping#sewer-line" class="text-white/60 hover:text-white text-sm transition-colors">Sewer Line Replacement</a></li>
          <li><a href="/repiping#water-main" class="text-white/60 hover:text-white text-sm transition-colors">Water Main Replacement</a></li>
          <li><a href="/water-heater-services#gas-line" class="text-white/60 hover:text-white text-sm transition-colors">Gas Line Installation</a></li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">Service Areas</h3>
        <ul class="space-y-2">
          <li><a href="/oviedo-plumber" class="text-white/60 hover:text-white text-sm transition-colors">Oviedo</a></li>
          <li><a href="/winter-springs-plumber" class="text-white/60 hover:text-white text-sm transition-colors">Winter Springs</a></li>
          <li><a href="/east-orlando-plumber" class="text-white/60 hover:text-white text-sm transition-colors">East Orlando</a></li>
          <li><a href="/lake-mary-plumber" class="text-white/60 hover:text-white text-sm transition-colors">Lake Mary</a></li>
          <li><a href="/alafaya-plumber" class="text-white/60 hover:text-white text-sm transition-colors">Alafaya / UCF</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">Company</h3>
        <ul class="space-y-2">
          <li><a href="/#contact" class="text-white/60 hover:text-white text-sm transition-colors">Get a Free Estimate</a></li>
          <li><a href="/privacy-policy" class="text-white/60 hover:text-white text-sm transition-colors">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Legal -->
    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-white/40 text-sm">
        &copy; {year} Bonet Plumbing LLC
        <span class="mx-2">|</span>
        Licensed & Insured &middot; License CFC1434246
        <span class="mx-2">|</span>
        Defending Central Florida Homes
        <span class="mx-2">|</span>
        <a href="/privacy-policy" class="hover:text-white/60 transition-colors">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>
