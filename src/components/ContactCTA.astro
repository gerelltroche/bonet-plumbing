---
import { Image } from 'astro:assets';
import headshot from '../assets/Headshot.jpeg';
import TextUsLink from './TextUsLink.astro';
import { PHONE_HREF as phone, PHONE_DISPLAY as phoneDisplay } from '../lib/contact';
import { useI18n } from '../i18n';

interface Props {
  /** Pre-select "Service Needed" (a value from the services list) on pages about one service. */
  defaultService?: string;
  /** Section id. Pass a different one for a second instance on the same page so field ids stay unique. */
  id?: string;
}
const { defaultService, id = "contact" } = Astro.props;
const { locale, t, l } = useI18n(Astro.url);

const services = t.contact.services;
const hasDefault = services.some((svc) => svc.value === defaultService);
---

<section id={id} class="bg-white py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Left column — persuasion -->
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-text mb-3">{t.contact.heading}</h2>
        <div class="w-16 h-1 bg-accent rounded-full mb-6"></div>

        <!-- Benefit bullets -->
        <ul class="space-y-4 mb-10">
          {t.contact.bullets.map((b) => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span class="text-text-secondary">{b}</span>
            </li>
          ))}
        </ul>

        <!-- Owner card -->
        <div class="flex items-center gap-4 bg-primary/5 border border-primary/10 rounded-lg p-4 mb-10">
          <Image src={headshot} alt={t.contact.ownerAlt} width={80} height={80} class="w-20 h-20 rounded-full object-cover object-[center_20%] shadow-md ring-2 ring-primary/15" format="webp" quality={80} loading="lazy" />
          <div>
            <p class="font-bold text-text">{t.contact.ownerName}</p>
            <p class="text-sm text-text-secondary">{t.contact.ownerTitle}</p>
            <p class="text-xs text-text-secondary/70">{t.contact.license}</p>
          </div>
        </div>

        <!-- Phone CTA -->
        <p class="text-text-secondary text-sm mb-3">{t.contact.preferCall}</p>
        <a
          href={phone}
          class="inline-flex items-center gap-3 bg-accent hover:bg-accent-light text-white font-bold text-lg px-8 py-4 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          {t.contact.callNow}: {phoneDisplay}
        </a>
        <p class="mt-4">
          <TextUsLink />
        </p>
      </div>

      <!-- Right column — form -->
      <!-- Form first on phones so the #contact anchor and the sticky bar land on it, not on the pitch. -->
      <div id={`${id}-form-container`} class="order-first lg:order-none bg-surface border border-border rounded-xl shadow-lg p-6 md:p-8">
        <h3 class="text-xl font-bold text-text mb-6">{t.contact.formHeading}</h3>

        <form
          id={`${id}-form`}
          name="contact"
          method="POST"
          action={l(t.contact.successPath)}
          netlify
          netlify-honeypot="bot-field"
        >
          <!-- Honeypot for spam prevention -->
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="page" value={Astro.url.pathname} />
          <p class="hidden" hidden aria-hidden="true">
            <label>{t.contact.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="space-y-5">
            <!-- Name -->
            <div>
              <label for={`${id}-name`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.name} <span class="text-red-600">*</span>
              </label>
              <input
                type="text"
                id={`${id}-name`}
                name="name"
                required
                placeholder={t.contact.namePlaceholder}
                class="w-full px-4 py-3 border border-border rounded-lg bg-background text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
              />
            </div>

            <!-- Phone -->
            <div>
              <label for={`${id}-phone`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.phone} <span class="text-red-600">*</span>
              </label>
              <input
                type="tel"
                id={`${id}-phone`}
                name="phone"
                required
                inputmode="tel"
                placeholder={t.contact.phonePlaceholder}
                class="w-full px-4 py-3 border border-border rounded-lg bg-background text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
              />
            </div>

            <!-- Service Needed -->
            <div>
              <label for={`${id}-service`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.service} <span class="text-red-600">*</span>
              </label>
              <select
                id={`${id}-service`}
                name="service"
                required
                class="w-full px-4 py-3 border border-border rounded-lg bg-background text-text focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors cursor-pointer"
              >
                <option value="" disabled selected={!hasDefault}>{t.contact.selectService}</option>
                {services.map((svc) => (
                  <option value={svc.value} selected={hasDefault && svc.value === defaultService}>{svc.label}</option>
                ))}
              </select>
            </div>

            <!-- Preferred language — posted as `language` (en|es); defaults to the page's language -->
            <fieldset>
              <legend class="block text-sm font-semibold text-text mb-1.5">{t.contact.language}</legend>
              <div class="flex gap-3">
                <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 border border-border rounded-lg bg-background text-text cursor-pointer has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/30 has-[:checked]:bg-primary/5 transition-colors">
                  <input type="radio" name="language" value="en" checked={locale === "en"} class="accent-primary" />
                  <span lang="en">{t.contact.languageEnglish}</span>
                </label>
                <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 border border-border rounded-lg bg-background text-text cursor-pointer has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/30 has-[:checked]:bg-primary/5 transition-colors">
                  <input type="radio" name="language" value="es" checked={locale === "es"} class="accent-primary" />
                  <span lang="es">{t.contact.languageSpanish}</span>
                </label>
              </div>
            </fieldset>

            <!-- Email (optional) -->
            <div>
              <label for={`${id}-email`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.email} <span class="text-text-muted text-xs font-normal">{t.contact.optional}</span>
              </label>
              <input
                type="email"
                id={`${id}-email`}
                name="email"
                placeholder={t.contact.emailPlaceholder}
                class="w-full px-4 py-3 border border-border rounded-lg bg-background text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
              />
            </div>

            <!-- Message (optional) -->
            <div>
              <label for={`${id}-message`} class="block text-sm font-semibold text-text mb-1.5">
                {t.contact.message} <span class="text-text-muted text-xs font-normal">{t.contact.optional}</span>
              </label>
              <textarea
                id={`${id}-message`}
                name="message"
                rows="3"
                placeholder={t.contact.messagePlaceholder}
                class="w-full px-4 py-3 border border-border rounded-lg bg-background text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit button -->
            <button
              type="submit"
              id={`${id}-submit`}
              class="w-full bg-accent hover:bg-accent-light text-white font-bold text-lg py-4 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg cursor-pointer"
            >
              {t.contact.submit}
            </button>

            <!-- Response time -->
            <p class="text-text-muted text-xs text-center">
              {t.contact.responseTime}
            </p>
          </div>
        </form>

      </div>
    </div>
  </div>
</section>
