---
// Spanish form-success page. The form on /es/ pages posts here (see
// ui.contact.successPath localized in ContactCTA). Strings come from src/i18n.
import Layout from "../../layouts/Layout.astro";
import StickyNav from "../../components/StickyNav.astro";
import Footer from "../../components/Footer.astro";
import { PHONE_HREF as phone, PHONE_DISPLAY as phoneDisplay } from "../../lib/contact";
import { useI18n } from "../../i18n";

const { t } = useI18n(Astro.url);
---

<Layout title={t.success.title} description={t.success.description} noindex={true} hideCtaBar={true}>
  <StickyNav />
  <main class="bg-white py-24 md:py-32">
    <div class="max-w-xl mx-auto px-4 text-center">
      <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-5">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
        </svg>
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-text mb-2">{t.success.heading}</h1>
      <p class="text-text-secondary mb-6">{t.success.body}</p>
      <p class="text-text-secondary text-sm mb-4">{t.success.sooner}</p>
      <a
        href={phone}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-light text-white font-bold px-6 py-3 rounded-lg shadow-md transition-all duration-200 hover:shadow-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
        </svg>
        {t.success.call} {phoneDisplay}
      </a>
    </div>
  </main>
  <Footer quoteHref="/#quick-quote" />
</Layout>
