---
import MobileCtaBar from "../components/MobileCtaBar.astro";
import { useI18n, alternateUrl, SITE_URL, LOCALES, DEFAULT_LOCALE } from "../i18n";
import { getReviews } from "../lib/reviews";
import { SERVICE_AREAS } from "../data/service-areas";
import "../styles/global.css";

interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  /** Page FAQs. When present, a FAQPage JSON-LD block is emitted. Pages render the same array visibly. */
  faq?: FaqItem[];
  title?: string;
  description?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  geoPlacename?: string;
  geoLat?: number;
  geoLng?: number;
  /** Target of the mobile bar's "Request a Quote": "#contact" on pages with the form, "/#contact" otherwise. */
  quoteHref?: string;
  /** Hide the mobile Call/Text/Quote bar (e.g. on the form success page). */
  hideCtaBar?: boolean;
}

const { locale, t } = useI18n(Astro.url);

const {
  title = t.site.defaultTitle,
  description = t.site.defaultDescription,
  noindex = false,
  breadcrumbs,
  faq,
  // Geo meta defaults to the primary market (East Orlando / Avalon Park). City
  // pages about a different market pass their own placename/coordinates. Note:
  // these tags are ignored by Google — they exist only for internal consistency.
  geoPlacename = "East Orlando, Florida",
  geoLat = 28.5087,
  geoLng = -81.1551,
  quoteHref = "#contact",
  hideCtaBar = false,
} = Astro.props;

const siteUrl = SITE_URL;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Every page has a twin in the other language at the same slug under /es/,
// so hreflang alternates are derived from the path (see src/i18n).
const alternates = LOCALES.map((l) => ({ lang: l, href: alternateUrl(Astro.url.pathname, l) }));
const xDefault = alternateUrl(Astro.url.pathname, DEFAULT_LOCALE);
const otherOgLocale = locale === "en" ? "es_US" : "en_US";

// Rating and count come from src/data/reviews.json via one loader, the same
// one the <Reviews /> section uses, so the schema can never disagree with the
// visible numbers on any page.
const { overallRating, reviewCount } = await getReviews();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Geo & Local SEO -->
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content={geoPlacename} />
    <meta name="geo.position" content={`${geoLat};${geoLng}`} />
    <meta name="ICBM" content={`${geoLat}, ${geoLng}`} />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Bonet Plumbing LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.site.ogImageAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={otherOgLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />
    <meta name="twitter:image:alt" content={t.site.ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Plumber",
      "@id": `${siteUrl}/#organization`,
      "name": "Bonet Plumbing LLC",
      "alternateName": "Bonet Plumbing",
      "description": t.site.orgDescription,
      "url": siteUrl,
      "telephone": "+14077343968",
      "image": `${siteUrl}/logo_with_text.jpeg`,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo_with_text.jpeg`,
        "width": 400,
        "height": 400
      },
      "availableLanguage": [
        { "@type": "Language", "name": "English", "alternateName": "en" },
        { "@type": "Language", "name": "Spanish", "alternateName": "es" }
      ],
      "sameAs": [
        // TODO: Add your actual profile URLs here
        // "https://www.google.com/maps/place/Bonet+Plumbing+LLC",
        // "https://www.facebook.com/bonetplumbing",
        // "https://www.yelp.com/biz/bonet-plumbing-oviedo"
      ],
      "areaServed": SERVICE_AREAS,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Oviedo",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 28.6700,
        "longitude": -81.2081
      },
      "priceRange": "$$",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": overallRating,
        "reviewCount": reviewCount,
        "bestRating": 5,
        "worstRating": 1
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Plumbing Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Whole-Home Repiping", "url": `${siteUrl}/repiping/` }},
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Water Heater Replacement & Tankless Installation", "url": `${siteUrl}/water-heater-services/` }},
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Slab Leak Repair", "url": `${siteUrl}/repiping/#slab-leak` }},
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sewer Line Replacement", "url": `${siteUrl}/repiping/#sewer-line` }},
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Water Main / Service Line Replacement", "url": `${siteUrl}/repiping/#water-main` }},
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gas Line Installation & Repair", "url": `${siteUrl}/water-heater-services/#gas-line` }}
        ]
      }
    })} />

    {breadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": item.name,
          ...(item.url ? { "item": item.url } : {})
        }))
      })} />
    )}

    {faq && faq.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faq.map((item) => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": { "@type": "Answer", "text": item.a }
        }))
      })} />
    )}

  </head>
  <body class:list={["min-h-screen antialiased bg-background text-text", !hideCtaBar && "pb-[calc(6rem+env(safe-area-inset-bottom))] md:pb-0"]}>
    <slot />
    {!hideCtaBar && <MobileCtaBar quoteHref={quoteHref} />}
  </body>
</html>
