---
// One-line Google rating shown directly above a quote form's submit button,
// where the visitor is deciding whether to send. Reads the same reviews.json
// as <Reviews /> and the JSON-LD, so the numbers always match.
import { getReviews } from "../lib/reviews";
import { useI18n } from "../i18n";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const { t } = useI18n(Astro.url);
const { overallRating, reviewCount } = await getReviews();
const star = "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118L10 16.011l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L1.665 9.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.518-4.674z";
---

<p class={`flex items-center justify-center gap-1.5 text-sm text-text-secondary ${className}`}>
  <span class="flex items-center gap-0.5" aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => (
      <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d={star}/></svg>
    ))}
  </span>
  <span><span class="font-bold text-text">{overallRating.toFixed(1)}</span> {t.contact.rating(reviewCount)}</span>
</p>
