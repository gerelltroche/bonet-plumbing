---
import Layout from "../layouts/Layout.astro";
import StickyNav from "../components/StickyNav.astro";
import Footer from "../components/Footer.astro";
import { PHONE_HREF as phone, PHONE_DISPLAY as phoneDisplay } from "../lib/contact";
import { useI18n } from "../i18n";

const { t, l } = useI18n(Astro.url);
---

<Layout title={t.notFound.title} description={t.notFound.description} noindex={true} quoteHref="/#quick-quote">
  <StickyNav />
  <main class="bg-white py-24 md:py-32">
    <div class="max-w-xl mx-auto px-4 text-center">
      <p class="text-6xl font-extrabold text-primary mb-4">404</p>
      <h1 class="text-2xl md:text-3xl font-bold text-text mb-4">{t.notFound.heading}</h1>
      <p class="text-text-secondary mb-8">{t.notFound.body}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={l("/")}
          class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-light text-white font-bold px-6 py-3 rounded-lg transition-all duration-200"
        >
          {t.notFound.home}
        </a>
        <a
          href={phone}
          class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-white font-bold px-6 py-3 rounded-lg transition-all duration-200"
        >
          {t.notFound.call} {phoneDisplay}
        </a>
      </div>
    </div>
  </main>
  <Footer quoteHref="/#quick-quote" />
</Layout>
