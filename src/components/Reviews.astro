---
import { getReviews } from "../lib/reviews";

const { reviews, overallRating, reviewCount, googleReviewsUrl } = await getReviews();

const initials = (name: string) =>
  name
    .split(" ")
    .map((p) => p[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

// Reviews longer than this get visually clamped + a "Read full review" link.
const CLAMP_THRESHOLD = 320;
---

<section class="bg-white py-16 md:py-20" aria-labelledby="reviews-heading">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Header + rating summary -->
    <div class="text-center mb-10 md:mb-12">
      <h2 id="reviews-heading" class="text-3xl md:text-4xl font-bold text-text mb-3">
        Trusted by Your Central Florida Neighbors
      </h2>
      <div class="w-16 h-1 bg-accent rounded-full mx-auto mb-5"></div>

      <div class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-text-secondary">
        <!-- Star row -->
        <div class="flex items-center gap-0.5" aria-label={`${overallRating} out of 5 stars`}>
          {[0, 1, 2, 3, 4].map((i) => (
            <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118L10 16.011l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L1.665 9.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.518-4.674z"/>
            </svg>
          ))}
        </div>
        <span class="font-bold text-text text-lg">{overallRating.toFixed(1)}</span>
        <span class="text-text-secondary">on</span>
        <!-- Google wordmark (multi-color G + word) -->
        <span class="inline-flex items-center gap-1.5 font-semibold text-text">
          <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0124 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 01-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
          </svg>
          Google
        </span>
        <span class="text-text-muted">·</span>
        <span class="text-text-secondary">Based on {reviewCount} reviews</span>
      </div>
    </div>

    <!-- Review cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-10">
      {reviews.map((r) => {
        const isLong = r.text.length > CLAMP_THRESHOLD;
        return (
          <article class="relative bg-surface border border-border rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <!-- Decorative quote mark -->
            <svg class="absolute top-4 right-4 w-8 h-8 text-primary/10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
            </svg>

            <!-- Stars -->
            <div class="flex items-center gap-0.5 mb-3" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < r.rating ? "text-accent" : "text-border"}`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118L10 16.011l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L1.665 9.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.518-4.674z"/>
                </svg>
              ))}
            </div>

            <!-- Review body -->
            <p class={`text-text-secondary leading-relaxed ${isLong ? "line-clamp-7 mb-3" : "mb-5"}`}>"{r.text}"</p>

            {isLong && (
              <a
                href={r.reviewUrl ?? googleReviewsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-light mb-5 self-start"
              >
                Read full review
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                </svg>
              </a>
            )}

            <!-- Author -->
            <div class="flex items-center gap-3 pt-4 border-t border-border/60 mt-auto">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center shrink-0" aria-hidden="true">
                {initials(r.author)}
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-text truncate">{r.author}</p>
                <p class="text-xs text-text-muted">
                  {r.location ? `${r.location} · ` : ""}{r.date}
                </p>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- CTA: read all on Google -->
    <div class="text-center">
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-white border border-border hover:border-primary/40 text-text font-semibold px-6 py-3 rounded-lg shadow-sm hover:shadow-md transition-all duration-200"
      >
        <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
          <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
          <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0124 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
          <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 01-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
        </svg>
        Read all reviews on Google
        <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
      </a>
    </div>
  </div>
</section>
