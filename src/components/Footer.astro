---
import { Image } from 'astro:assets';
import logo from '../assets/logo_with_text.jpeg';
import TextUsLink from './TextUsLink.astro';
import LangBadge from './LangBadge.astro';
import { PHONE_HREF as phone, PHONE_DISPLAY as phoneDisplay } from '../lib/contact';
import { useI18n } from '../i18n';

interface Props {
  /** Target of the footer's "Request a Quote": this page's form ("#contact" by default),
   *  or "/#quick-quote" on pages without one. */
  quoteHref?: string;
}
const { quoteHref = "#contact" } = Astro.props;
const year = new Date().getFullYear();
const { t, l } = useI18n(Astro.url);
const areaLinks = [...t.areas.main, ...t.areas.more];
---

<footer class="bg-primary-dark border-t border-white/10">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start">
        <a href={l("/")}>
          <Image src={logo} alt={t.footer.logoAlt} width={64} height={64} class="h-16 w-auto rounded bg-white p-1 mb-2" format="webp" quality={80} loading="lazy" />
        </a>
        <span class="text-lg font-bold text-white/90">Bonet Plumbing LLC</span>
        <a href={phone} class="text-white/70 hover:text-white text-sm transition-colors mt-1">
          {phoneDisplay}
        </a>
        <TextUsLink tone="light" class="mt-2" />
        <span class="text-white/50 text-sm">{t.footer.available}</span>
        <div class="mt-3">
          <LangBadge variant="footer" />
        </div>
      </div>

      <!-- Services -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">{t.footer.services}</h3>
        <ul class="space-y-2">
          {t.footer.serviceLinks.map((s) => (
            <li><a href={l(s.href)} class="text-white/60 hover:text-white text-sm transition-colors">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Service Areas -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">{t.footer.areas}</h3>
        <ul class="space-y-2">
          {areaLinks.map((a) => (
            <li><a href={l(a.href)} class="text-white/60 hover:text-white text-sm transition-colors">{a.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div class="text-center md:text-left">
        <h3 class="text-white/90 font-bold text-sm uppercase tracking-wider mb-3">{t.footer.company}</h3>
        <ul class="space-y-2">
          <li><a href={l(quoteHref)} class="text-white/60 hover:text-white text-sm transition-colors">{t.footer.quote}</a></li>
          <li><a href={l("/privacy-policy/")} class="text-white/60 hover:text-white text-sm transition-colors">{t.footer.privacy}</a></li>
        </ul>
      </div>
    </div>

    <!-- Legal -->
    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-white/40 text-sm">
        &copy; {year} Bonet Plumbing LLC
        <span class="mx-2">|</span>
        {t.footer.licensed}
        <span class="mx-2">|</span>
        {t.footer.motto}
        <span class="mx-2">|</span>
        <a href={l("/privacy-policy/")} class="hover:text-white/60 transition-colors">{t.footer.privacy}</a>
      </p>
    </div>
  </div>
</footer>
